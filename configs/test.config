/*
 * test.config
 * ===========
 * A small run on the files in tests/data. Nothing is fetched and no ontology
 * service is called: the three resolve files and the dataset list are given.
 * Step 5 still reads the CellxGene Census, so a real run needs a network and
 * an image or an environment with cellxgene-census.
 *
 * Usage:
 *   nextflow run main.nf -profile test
 *   nextflow run main.nf -profile test,local        (installed cellxgene-harvester, no container)
 *   nextflow run main.nf -profile test -stub-run    (checks the wiring only)
 */

params {
    organ                     = 'neocortex'
    uberon_json               = "${projectDir}/tests/data/uberon_neocortex.json"
    disease_json              = "${projectDir}/tests/data/disease_normal.json"
    hsapdv_json               = "${projectDir}/tests/data/hsapdv_adult_15.json"
    all_datasets_complete_csv = "${projectDir}/tests/data/all_datasets_complete.csv"
    run_name                  = 'test-run'
    count_max_forks           = 2
}

// the report files are set in nextflow.config before a profile is applied, so
// they are set again here to follow the run_name of this profile
timeline.file = "${params.run_name}/pipeline_timeline.html"
trace.file    = "${params.run_name}/pipeline_trace.txt"
dag.file      = "${params.run_name}/pipeline_dag.html"
