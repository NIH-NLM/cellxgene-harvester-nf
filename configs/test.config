/*
 * test.config
 * ===========
 * A small run on the mini kidney h5ad file (3566 cells, one dataset). The dataset
 * list is a one-row file in tests/data. The resolve steps run normally and call
 * the ontology service (OLS4). Step 5 reads the mini file, not CellxGene, so no
 * other h5ad file is downloaded.
 *
 * The mini file is nlm-ckn/data/test/kidney/h5ad/minilake.h5ad.tar.gz. Unpack it
 * and give the file: --h5ad path/to/adata_normal_n3566.h5ad
 * (tests/get_mini_h5ad.sh does this). On Lifebit, give the edited file in S3.
 *
 * Usage:
 *   nextflow run main.nf -profile test --h5ad adata_normal_n3566.h5ad
 *   nextflow run main.nf -profile test,local --h5ad adata_normal_n3566.h5ad   (installed cellxgene-harvester, no container)
 *   nextflow run main.nf -profile test -stub-run    (checks the wiring only)
 */

params {
    organ                     = 'kidney'
    disease                   = 'normal'
    min_age                   = 15
    author_cell_type          = 'subclass.full'   // the author's cell types in the mini kidney file (Lake 2023)
    embedding                 = 'X_umap'          // its embedding
    assay                     = "10x 3' v3"   // all four resolve steps run; every cell of the mini file has this assay (EFO:0009922)
    all_datasets_complete_csv = "${projectDir}/tests/data/all_datasets_complete.csv"
    run_name                  = 'test-run'
    publish_env               = 'test'
    count_max_forks           = 1
    count_memory              = '4 GB'      // a GitHub runner has about 15 GB; the mini file needs little
    count_cpus                = 1
}

// the report files are set in nextflow.config before a profile is applied, so
// they are set again here to follow the run_name of this profile
timeline.file = "${params.run_name}/pipeline_timeline.html"
trace.file    = "${params.run_name}/pipeline_trace.txt"
dag.file      = "${params.run_name}/pipeline_dag.html"
