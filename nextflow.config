manifest {
    name            = 'NIH-NLM/cellxgene-harvester-nf'
    description     = 'Nextflow workflow for cellxgene-harvester: find the CellxGene datasets of one organ, disease state and age, and count their cells.'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
}

timeline.enabled   = true
timeline.overwrite = true
trace.enabled      = true
trace.overwrite    = true
dag.enabled        = true
dag.overwrite      = true

params {
    // ---- what to harvest -------------------------------------------------
    organ          = null             // UBERON label or id, for example 'kidney'. Needed unless uberon_json is given
    uberon_relation = null            // optional: exact relation label(s) whose terms are added to the organ with their descendants, for example ['contributes to morphology of'] (adds the nose to the respiratory system). The organ stays one root term
    disease        = 'normal'         // disease or phenotype label or id, for example 'normal'
    min_age        = 15               // minimum age in years (HsapDv)
    assay_name     = 'published'      // name of the assay file: assay_<assay_name>.json and .csv. Name the SET of assays, not its first label
    assay          = null             // optional: the assay (technique) labels or EFO ids you WANT, for example ['10x 3\' v3', 'Smart-seq2']. Only the cells of these assays are counted
    organism       = 'Homo sapiens'   // keep datasets of this organism; '' keeps every organism
    no_preprints   = false            // true leaves preprints out
    author_cell_type = null           // curation.author_cell_type for EVERY dataset: the obs column of the author's cell types. null takes it from the CSV. For one dataset, such as a test
    embedding        = null           // curation.embedding for EVERY dataset: the obsm key of the embedding, for example 'X_umap'. null takes it from the CSV

    // ---- files to use instead of resolving or fetching ---------------------
    uberon_json               = null  // a file from resolve-uberon
    disease_json              = null  // a file from resolve-disease
    hsapdv_json               = null  // a file from resolve-hsapdv
    assay_json                = null  // a file from resolve-assay
    all_datasets_complete_csv = null  // a file from append-details: skips steps 1 to 3
    h5ad                      = null  // a local h5ad file to read instead of each dataset's h5ad_url (for tests; use with ONE dataset)

    // ---- where the filtered h5ad files go (TEMPORARY, to be set) -----------------
    // The filtered h5ad files are read by sc-nsforest-qc-nf, so they must be published
    // in a public S3 bucket on the STRIDES account. The location is not set yet.
    h5ad_publish_dir = null           // folder the files are copied to; null = <run_name>/filtered_h5ad, a fixed folder in the results
    h5ad_url_prefix  = null           // public address of that folder, written to filtered_h5ad_url and the CSV; null = the local path

    // ---- where the results go --------------------------------------------
    run_name     = 'cellxgene-harvester-nf'   // the results folder: a FIXED name, no date or run name (the publish branch in nlm-ckn is dated; this folder is not)
    publish_mode = 'copy'

    // ---- step 8: publish to a branch of a GitHub repository, for inspection and merge ----
    github_token  = null              // a token that can push to publish_repo. null skips the publish step
    publish_repo  = 'NIH-NLM/nlm-ckn'
    publish_env   = 'prod'            // 'prod': data/prod/<organ>/cellxgene-harvester-nf and data/prod/ontology_lookup_server; 'test': the same under data/test, and the filtered h5ad in data/test/<organ>/filtered-h5ad
    publish_dest_dir = null           // replaces the organ folder above (the final JSON and CSV, and the organ's resolve files)
    publish_shared_dir = null         // replaces data/<publish_env>/ontology_lookup_server (disease, hsapdv and assay files, JSON and CSV)

    // ---- container and limits ---------------------------------------------
    container       = 'ghcr.io/nih-nlm/cellxgene-harvester:latest'
    count_max_forks = 4               // datasets counted at the same time
    count_cpus      = 2
    count_memory    = '16 GB'
}

timeline.file = "${params.run_name}/pipeline_timeline.html"
trace.file    = "${params.run_name}/pipeline_trace.txt"
dag.file      = "${params.run_name}/pipeline_dag.html"

docker {
    enabled    = true
    // --pull always: a branch or latest tag is moved by every commit, so the image is pulled again for each task, as in sc-nsforest-qc-nf
    // run as the user who starts the workflow: the image's own user cannot write to the work folder
    // on a GitHub runner ("touch: cannot touch '.command.trace': Permission denied"). HOME must be writable for that user
    runOptions = '--platform linux/amd64 --pull always -u $(id -u):$(id -g) -e HOME=/tmp'
}

process {
    container        = params.container
    containerOptions = '--entrypoint ""'     // the image starts the cellxgene-harvester command; the steps need a shell

    withName: 'resolve_uberon_process|resolve_disease_process|resolve_hsapdv_process|resolve_assay_process' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'fetch_collections_process' {
        cpus   = 1
        memory = '2 GB'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'generate_metadata_process' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'append_details_process' {
        cpus   = 1
        memory = '4 GB'
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'filter_datasets_process' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'count_cells_process' {
        // closures, so a profile or the command line can change the params after this file is read
        cpus     = { params.count_cpus }
        memory   = { params.count_memory }
        maxForks = params.count_max_forks
        // a dataset that cannot be counted after two more tries is left out and named in the log
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'publish_github_process' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'final_cleanup_process|export_datasets_csv_process' {
        cpus   = 1
        memory = '2 GB'
    }
}

profiles {
    // use the cellxgene-harvester installed on this machine, without a container
    local {
        docker.enabled           = false
        process.container        = null
        process.containerOptions = null
    }
    // small files in tests/data, for a quick run
    test {
        includeConfig 'configs/test.config'
    }
}
